# Public maintenance repositories. Override GITHUB_ORG only for a complete compatible fork.
REPO_PROFILE=github
GITHUB_ORG=${GITHUB_ORG:-insightos-community}
GITHUB_ROOT=https://github.com/${GITHUB_ORG}
REPO_VERSIONS_FILE=repo-versions.json
REPO_LIST="semantic-framework semantic-web semantic-docs semantic-ability/r1pro-ability semantic-robotsdk/robot-sdk semantic-skill/robot-skill semantic-simulation/mujoco-runtime semantic-scene/mujoco-asset semantic-robot-deployment semantic-ability/ability-runtime ability-framework/abilityframework ability-framework/ability-py-sdk ability-framework/ability-scaffold"
REPO_URL_SEMANTIC_FRAMEWORK=${GITHUB_ROOT}/Sementic-Framework.git
REPO_URL_SEMANTIC_WEB=${GITHUB_ROOT}/semantic-web.git
REPO_URL_SEMANTIC_DOCS=${GITHUB_ROOT}/semantic-docs.git
REPO_URL_SEMANTIC_ABILITY_R1PRO_ABILITY=${GITHUB_ROOT}/r1pro-ability.git
REPO_URL_SEMANTIC_ROBOTSDK_ROBOT_SDK=${GITHUB_ROOT}/robot-sdk.git
REPO_URL_SEMANTIC_SKILL_ROBOT_SKILL=${GITHUB_ROOT}/robot-skill.git
REPO_URL_SEMANTIC_SIMULATION_MUJOCO_RUNTIME=${GITHUB_ROOT}/mujoco-runtime.git
REPO_URL_SEMANTIC_SCENE_MUJOCO_ASSET=${GITHUB_ROOT}/mujoco-asset.git
REPO_URL_SEMANTIC_ROBOT_DEPLOYMENT=${GITHUB_ROOT}/semantic-deployment.git
REPO_URL_SEMANTIC_ABILITY_ABILITY_RUNTIME=${GITHUB_ROOT}/ability-runtime.git
REPO_URL_ABILITY_FRAMEWORK_ABILITYFRAMEWORK=${GITHUB_ROOT}/AbilityFramework.git
REPO_URL_ABILITY_FRAMEWORK_ABILITY_PY_SDK=${GITHUB_ROOT}/Ability-SDK-Python.git
REPO_URL_ABILITY_FRAMEWORK_ABILITY_SCAFFOLD=${GITHUB_ROOT}/ability-scaffold.git
