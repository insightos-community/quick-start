# fork 来源的原始 GitLab 路径，来自安装器 UPSTREAM_REPOS。
REPO_PROFILE=upstream
GITLAB_SSH_ROOT=${GITLAB_SSH_ROOT:-ssh://git@gitlab.example.invalid:22}
# 相对路径以本配置文件目录为基准。SEMANTIC 可选，默认沿用 shell 设置。
REPO_VERSIONS_FILE=repo-versions.json
REPO_LIST="semantic-framework semantic-web semantic-docs semantic-ability/r1pro-ability semantic-robotsdk/robot-sdk semantic-skill/robot-skill semantic-simulation/mujoco-runtime semantic-scene/mujoco-asset semantic-robot-deployment semantic-ability/ability-runtime ability-framework/abilityframework ability-framework/ability-py-sdk ability-framework/ability-scaffold"
REPO_URL_SEMANTIC_FRAMEWORK=${GITLAB_SSH_ROOT}/example/semantic/semantic-framework.git
REPO_URL_SEMANTIC_WEB=${GITLAB_SSH_ROOT}/example/semantic/semantic-web.git
REPO_URL_SEMANTIC_DOCS=${GITLAB_SSH_ROOT}/example/semantic/semantic-docs.git
REPO_URL_SEMANTIC_ABILITY_R1PRO_ABILITY=${GITLAB_SSH_ROOT}/example/semantic/semantic-ability/r1pro-ability.git
REPO_URL_SEMANTIC_ROBOTSDK_ROBOT_SDK=${GITLAB_SSH_ROOT}/example/semantic/semantic-robotsdk/robot-sdk.git
REPO_URL_SEMANTIC_SKILL_ROBOT_SKILL=${GITLAB_SSH_ROOT}/example/semantic/semantic-skill/robot-skill.git
REPO_URL_SEMANTIC_SIMULATION_MUJOCO_RUNTIME=${GITLAB_SSH_ROOT}/example/semantic/semantic-simulation/mujoco-runtime.git
REPO_URL_SEMANTIC_SCENE_MUJOCO_ASSET=${GITLAB_SSH_ROOT}/example/semantic/semantic-scene/mujoco-asset.git
REPO_URL_SEMANTIC_ROBOT_DEPLOYMENT=${GITLAB_SSH_ROOT}/example/semantic/semantic-deployment.git
REPO_URL_SEMANTIC_ABILITY_ABILITY_RUNTIME=${GITLAB_SSH_ROOT}/example/semantic/semantic-ability/ability-runtime.git
REPO_URL_ABILITY_FRAMEWORK_ABILITYFRAMEWORK=${GITLAB_SSH_ROOT}/example/ability/abilityframework.git
REPO_URL_ABILITY_FRAMEWORK_ABILITY_PY_SDK=${GITLAB_SSH_ROOT}/example/ability/ability-py-sdk.git
REPO_URL_ABILITY_FRAMEWORK_ABILITY_SCAFFOLD=${GITLAB_SSH_ROOT}/example/ability/ability-scaffold.git
