# 当前开发/预发布 fork 仓库。修改 ROOT 可统一切换协议、服务器或端口。
REPO_PROFILE=staging
GITLAB_SSH_ROOT=${GITLAB_SSH_ROOT:-ssh://git@gitlab.example.invalid:22}
# 相对路径以本配置文件目录为基准。SEMANTIC 可选，默认沿用 shell 设置。
REPO_VERSIONS_FILE=repo-versions.json
REPO_LIST="semantic-framework semantic-web semantic-docs semantic-ability/r1pro-ability semantic-robotsdk/robot-sdk semantic-skill/robot-skill semantic-simulation/mujoco-runtime semantic-scene/mujoco-asset semantic-robot-deployment semantic-ability/ability-runtime ability-framework/abilityframework ability-framework/ability-py-sdk ability-framework/ability-scaffold"
REPO_URL_SEMANTIC_FRAMEWORK=${GITLAB_SSH_ROOT}/staging/semantic-framework.git
REPO_URL_SEMANTIC_WEB=${GITLAB_SSH_ROOT}/staging/semantic-web.git
REPO_URL_SEMANTIC_DOCS=${GITLAB_SSH_ROOT}/staging/semantic-docs.git
REPO_URL_SEMANTIC_ABILITY_R1PRO_ABILITY=${GITLAB_SSH_ROOT}/staging/r1pro-ability.git
REPO_URL_SEMANTIC_ROBOTSDK_ROBOT_SDK=${GITLAB_SSH_ROOT}/staging/robot-sdk.git
REPO_URL_SEMANTIC_SKILL_ROBOT_SKILL=${GITLAB_SSH_ROOT}/staging/robot-skill.git
REPO_URL_SEMANTIC_SIMULATION_MUJOCO_RUNTIME=${GITLAB_SSH_ROOT}/staging/mujoco-runtime.git
REPO_URL_SEMANTIC_SCENE_MUJOCO_ASSET=${GITLAB_SSH_ROOT}/staging/mujoco-asset.git
REPO_URL_SEMANTIC_ROBOT_DEPLOYMENT=${GITLAB_SSH_ROOT}/staging/semantic-deployment.git
REPO_URL_SEMANTIC_ABILITY_ABILITY_RUNTIME=${GITLAB_SSH_ROOT}/staging/ability-runtime.git
REPO_URL_ABILITY_FRAMEWORK_ABILITYFRAMEWORK=${GITLAB_SSH_ROOT}/staging/abilityframework.git
REPO_URL_ABILITY_FRAMEWORK_ABILITY_PY_SDK=${GITLAB_SSH_ROOT}/staging/ability-py-sdk.git
REPO_URL_ABILITY_FRAMEWORK_ABILITY_SCAFFOLD=${GITLAB_SSH_ROOT}/staging/ability-scaffold.git
